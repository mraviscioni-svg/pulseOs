# Copiá a .env (gitignored). Podés usar los mismos nombres que en GitHub Secrets.

APP_NAME=PulseOS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# MySQL — nombres de GitHub (PROD_DB_*) o estándar (DB_*)
PROD_DB_HOST=127.0.0.1
PROD_DB_NAME=pulseos
PROD_DB_USER=root
PROD_DB_PASSWORD=

# Alternativa equivalente para la app:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pulseos
# DB_USERNAME=root
# DB_PASSWORD=

DB_CHARSET=utf8mb4

# FTP — mismos nombres que GitHub Secrets
FTP_SERVER=ftp.tudominio.com
FTP_USERNAME=usuario_ftp
FTP_PASSWORD=
FTP_SERVER_DIR=./

SESSION_LIFETIME=7200
MAIL_FROM=noreply@tudominio.com
