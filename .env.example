# Copiá este archivo a .env (nunca subas .env a Git)
# Para que el agente en Cursor pruebe FTP/MySQL: completá .env en tu PC con los mismos datos del hosting.

APP_NAME=PulseOS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# --- MySQL (prep o local) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pulseos
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- FTP (Taller Boedo / hosting) — mismos nombres que GitHub Secrets ---
FTP_SERVER=ftp.tudominio.com
FTP_USERNAME=usuario_ftp
FTP_PASSWORD=
FTP_SERVER_DIR=./
# FTP_SERVER_DIR debe terminar en /  ej: ./  o public_html/

SESSION_LIFETIME=7200
MAIL_FROM=noreply@tudominio.com
